#---------------------------------------------------------------------------------
# Basilisk II for the Nintendo Wii
#
#   make          BasiliskIIWii.dol and SheepShaverWii.dol
#   make dist     Homebrew Channel folders and zips in dist/
#
# Needs devkitPPC and libogc, and a C/C++ compiler for this computer (the
# 68k emulator core is generated by build68k and gencpu at build time).
# libwiiinput, libwiiupdate and libwiiosk are git submodules:
# git submodule update --init
#---------------------------------------------------------------------------------
.SUFFIXES:

ifeq ($(strip $(DEVKITPPC)),)
$(error "Please set DEVKITPPC in your environment. export DEVKITPPC=<path to>devkitPPC")
endif

include $(DEVKITPPC)/wii_rules

VERSION       ?= 1.0.0
UPDATE_OWNER  ?= quatric
UPDATE_REPO   ?= macemu-wii

APP_FOLDER    := BasiliskIIWii
APP_TITLE     := Basilisk II Wii
TARGET        := $(APP_FOLDER)
BUILD         := build
GEN           := $(BUILD)/gen

B2            := ../BasiliskII/src
WIIINPUT      := libwiiinput
WIIUPDATE     := libwiiupdate
WIIOSK        := libwiiosk

HOSTCC        ?= cc
HOSTCXX       ?= c++

#---------------------------------------------------------------------------------
# sources
#---------------------------------------------------------------------------------
CORE_SRCS     := main.cpp prefs.cpp prefs_items.cpp rom_patches.cpp slot_rom.cpp \
                 rsrc_patches.cpp emul_op.cpp macos_util.cpp xpram.cpp timer.cpp \
                 adb.cpp serial.cpp ether.cpp sony.cpp disk.cpp cdrom.cpp scsi.cpp \
                 video.cpp audio.cpp user_strings.cpp \
                 dummy/clip_dummy.cpp dummy/ether_dummy.cpp dummy/serial_dummy.cpp \
                 dummy/scsi_dummy.cpp dummy/prefs_editor_dummy.cpp \
                 uae_cpu/basilisk_glue.cpp uae_cpu/memory.cpp uae_cpu/newcpu.cpp \
                 uae_cpu/readcpu.cpp uae_cpu/fpu/fpu_uae.cpp
PLAT_SRCS     := main_wii.cpp prefs_wii.cpp sys_wii.cpp timer_wii.cpp xpram_wii.cpp \
                 user_strings_wii.cpp audio_wii.cpp video_wii.cpp ui_wii.cpp plat_wii.cpp
CPUEMU_PARTS  := 1 2 3 4 5 6 7 8

INPUT_SRCS    := $(wildcard $(WIIINPUT)/source/*.c)

CORE_OBJS     := $(addprefix $(BUILD)/b2/,$(CORE_SRCS:.cpp=.o))
PLAT_OBJS     := $(addprefix $(BUILD)/wii/,$(PLAT_SRCS:.cpp=.o))
GEN_OBJS      := $(GEN)/cpudefs.o $(GEN)/cpustbl.o
CPUEMU_OBJS   := $(foreach p,$(CPUEMU_PARTS),$(GEN)/cpuemu$(p).o)
INPUT_OBJS    := $(patsubst $(WIIINPUT)/source/%.c,$(BUILD)/wiiinput/%.o,$(INPUT_SRCS))
OBJS          := $(CORE_OBJS) $(PLAT_OBJS) $(GEN_OBJS) $(CPUEMU_OBJS) $(INPUT_OBJS)

INCLUDE       := -I$(B2)/Wii -I$(GEN) -I$(B2)/include -I$(B2)/uae_cpu \
                 -I$(WIIINPUT)/include -I$(WIIUPDATE)/include -I$(WIIOSK)/include \
                 -I$(LIBOGC_INC) $(foreach dir,$(PORTLIBS),-I$(dir)/include)

DEFS          := -DFPU_UAE -DAPP_VERSION=\"$(VERSION)\" -DUPDATE_OWNER=\"$(UPDATE_OWNER)\" \
                 -DUPDATE_REPO=\"$(UPDATE_REPO)\" -DAPP_FOLDER=\"$(APP_FOLDER)\" -DUPDATE_ASSET=\"BasiliskII\" \
                 -DAPP_TITLE="\"$(APP_TITLE)\""
CFLAGS        := -O2 -Wall -Wno-unused -Wno-sign-compare -fno-strict-aliasing \
                 -ffunction-sections $(MACHDEP) $(INCLUDE) $(DEFS) $(EXTRA_CFLAGS)
CXXFLAGS      := $(CFLAGS) -fno-exceptions -Wno-narrowing -Wno-register -std=gnu++14
LDFLAGS       := $(MACHDEP) -Wl,--gc-sections -Wl,-Map,$(BUILD)/$(TARGET).map
LIBS          := -L$(WIIUPDATE)/lib -L$(WIIOSK)/lib -L$(LIBOGC_LIB) \
                 $(foreach dir,$(PORTLIBS),-L$(dir)/lib) \
                 -lwiiupdate -lwiiosk -lwiikeyboard -lasnd -lfat -lwiiuse -lbte -logc -lm

# make builds Basilisk II and SheepShaver (sheepshaver.mk)
all: $(TARGET).dol sheepshaver

# (after the shared libraries, so two makes never build them at once)
sheepshaver: $(WIIUPDATE)/lib/libwiiupdate.a $(WIIOSK)/lib/libwiiosk.a
	@$(MAKE) --no-print-directory -f sheepshaver.mk


$(TARGET).dol: $(BUILD)/$(TARGET).elf
	@echo output ... $@
	@elf2dol $< $@

$(BUILD)/$(TARGET).elf: $(OBJS) $(WIIUPDATE)/lib/libwiiupdate.a $(WIIOSK)/lib/libwiiosk.a
	@echo linking ... $(notdir $@)
	@$(CXX) $(OBJS) $(LDFLAGS) $(LIBS) -o $@

$(WIIUPDATE)/lib/libwiiupdate.a:
	@$(MAKE) --no-print-directory -C $(WIIUPDATE)

$(WIIOSK)/lib/libwiiosk.a:
	@$(MAKE) --no-print-directory -C $(WIIOSK)

#---------------------------------------------------------------------------------
# the 68k core, generated on this computer
#---------------------------------------------------------------------------------
HOSTINC       := -I$(B2)/Wii -I$(GEN) -I$(B2)/include -I$(B2)/uae_cpu

$(GEN)/build68k: $(B2)/uae_cpu/build68k.c
	@mkdir -p $(GEN)
	@echo host: build68k
	@$(HOSTCC) -O1 -w $(HOSTINC) $< -o $@

$(GEN)/cpudefs.cpp: $(GEN)/build68k $(B2)/uae_cpu/table68k
	@$(GEN)/build68k < $(B2)/uae_cpu/table68k > $@

$(GEN)/gencpu: $(B2)/uae_cpu/gencpu.c $(B2)/uae_cpu/readcpu.cpp $(GEN)/cpudefs.cpp
	@echo host: gencpu
	@$(HOSTCC) -O1 -w $(HOSTINC) -c $(B2)/uae_cpu/gencpu.c -o $(GEN)/gencpu.ho
	@$(HOSTCXX) -O1 -w $(HOSTINC) -c $(B2)/uae_cpu/readcpu.cpp -o $(GEN)/readcpu.ho
	@$(HOSTCXX) -O1 -w $(HOSTINC) -c $(GEN)/cpudefs.cpp -o $(GEN)/cpudefs.ho
	@$(HOSTCXX) $(GEN)/gencpu.ho $(GEN)/readcpu.ho $(GEN)/cpudefs.ho -o $@

$(GEN)/cpuemu.cpp: $(GEN)/gencpu
	@echo host: generating the 68k emulator
	@cd $(GEN) && ./gencpu

$(GEN)/cpustbl.cpp $(GEN)/cputbl.h: $(GEN)/cpuemu.cpp

$(CPUEMU_OBJS): $(GEN)/cpuemu%.o: $(GEN)/cpuemu.cpp $(GEN)/cputbl.h
	@echo cpuemu part $*
	@$(CXX) $(CXXFLAGS) -DPART_$* -c $< -o $@

$(GEN_OBJS): $(GEN)/%.o: $(GEN)/%.cpp $(GEN)/cputbl.h
	@echo $(notdir $<)
	@$(CXX) $(CXXFLAGS) -c $< -o $@

#---------------------------------------------------------------------------------
# Basilisk II and the Wii code
#---------------------------------------------------------------------------------
$(CORE_OBJS): $(BUILD)/b2/%.o: $(B2)/%.cpp $(GEN)/cputbl.h
	@mkdir -p $(dir $@)
	@echo $(notdir $<)
	@$(CXX) $(CXXFLAGS) -MMD -MP -c $< -o $@

# Rebuild the Wii code when VERSION, the update repository or EXTRA_CFLAGS change
FLAGSTAMP := $(BUILD)/flags
$(shell mkdir -p $(BUILD); echo '$(CXXFLAGS)' | cmp -s - $(FLAGSTAMP) \
	|| echo '$(CXXFLAGS)' > $(FLAGSTAMP))

$(PLAT_OBJS): $(BUILD)/wii/%.o: $(B2)/Wii/%.cpp $(GEN)/cputbl.h Makefile $(FLAGSTAMP)
	@mkdir -p $(dir $@)
	@echo $(notdir $<)
	@$(CXX) $(CXXFLAGS) -MMD -MP -c $< -o $@

$(INPUT_OBJS): $(BUILD)/wiiinput/%.o: $(WIIINPUT)/source/%.c
	@mkdir -p $(dir $@)
	@echo $(notdir $<)
	@$(CC) $(CFLAGS) -w -c $< -o $@

-include $(shell find $(BUILD) -name '*.d' 2>/dev/null)

#---------------------------------------------------------------------------------
DISTDIR := dist/apps/$(APP_FOLDER)

dist: $(TARGET).dol
	@$(MAKE) --no-print-directory -f sheepshaver.mk dist
	@rm -rf $(DISTDIR)
	@mkdir -p $(DISTDIR)
	@cp $(TARGET).dol $(DISTDIR)/boot.dol
	@cp icon.png $(DISTDIR)/icon.png
	@sed -e 's/@NAME@/$(APP_TITLE)/' -e 's/@VERSION@/$(VERSION)/' \
	     -e 's/@FOLDER@/$(APP_FOLDER)/' \
	     -e "s/@DATE@/$$(date +%Y%m%d%H%M%S)/" meta.xml.in > $(DISTDIR)/meta.xml
	@cd dist && rm -f $(APP_FOLDER)-$(VERSION)-hbc.zip \
		&& zip -qr $(APP_FOLDER)-$(VERSION)-hbc.zip apps/$(APP_FOLDER)
	@echo built dist/$(APP_FOLDER)-$(VERSION)-hbc.zip

clean:
	@$(MAKE) --no-print-directory -f sheepshaver.mk clean
	@rm -rf build dist $(TARGET).dol
	@$(MAKE) --no-print-directory -C $(WIIUPDATE) clean
	@$(MAKE) --no-print-directory -C $(WIIOSK) clean

.PHONY: all sheepshaver dist clean
