#---------------------------------------------------------------------------------
# Basilisk II for the Nintendo Wii U (Aroma)
#
#   make          BasiliskIIWiiU.wuhb
#   make dist     wiiu/apps/... folder and zip in dist/
#
# Needs devkitPPC, wut and wiiu-sdl2, and a C/C++ compiler for this computer
# (the 68k emulator core is generated by build68k and gencpu at build time).
# libwiiuinput and libwiiuupdate are git submodules here, libwiiosk is the
# Wii build's (../wii/libwiiosk): git submodule update --init
#---------------------------------------------------------------------------------
.SUFFIXES:

ifeq ($(strip $(DEVKITPRO)),)
$(error "Please set DEVKITPRO in your environment. export DEVKITPRO=<path to>/devkitPro")
endif
export DEVKITPPC ?= $(DEVKITPRO)/devkitPPC

include $(DEVKITPRO)/wut/share/wut_rules

VERSION       ?= 1.0.0
UPDATE_OWNER  ?= quatric
UPDATE_REPO   ?= macemu-wii

APP_FOLDER    := BasiliskIIWiiU
APP_TITLE     := Basilisk II Wii U
TARGET        := $(APP_FOLDER)
BUILD         := build
GEN           := $(BUILD)/gen

B2            := ../BasiliskII/src
WIIUINPUT     := libwiiuinput
WIIUUPDATE    := libwiiuupdate
WIIOSK        := ../wii/libwiiosk

# the controller library without the microphones and pen tablets
INPUT_OPTS    := WITH_MIC=0 WITH_TABLET=0

HOSTCC        ?= cc
HOSTCXX       ?= c++

APP_NAME      := $(APP_TITLE)
APP_SHORTNAME := Basilisk II
APP_AUTHOR    := quatric
APP_ICON      := icon.png
APP_TV_SPLASH := splash-tv.png
APP_DRC_SPLASH := splash-drc.png
# wut_rules read these when it was included; set the options again here
WUHB_OPTIONS  := --name "$(APP_NAME)" --short-name "$(APP_SHORTNAME)" \
                 --author "$(APP_AUTHOR)" --icon=$(APP_ICON) \
                 --tv-image=$(APP_TV_SPLASH) --drc-image=$(APP_DRC_SPLASH)

#---------------------------------------------------------------------------------
# sources
#---------------------------------------------------------------------------------
CORE_SRCS     := main.cpp prefs.cpp prefs_items.cpp rom_patches.cpp slot_rom.cpp \
                 rsrc_patches.cpp emul_op.cpp macos_util.cpp xpram.cpp timer.cpp \
                 adb.cpp serial.cpp ether.cpp sony.cpp disk.cpp cdrom.cpp scsi.cpp \
                 video.cpp audio.cpp user_strings.cpp \
                 dummy/clip_dummy.cpp dummy/ether_dummy.cpp dummy/serial_dummy.cpp \
                 dummy/scsi_dummy.cpp dummy/prefs_editor_dummy.cpp \
                 uae_cpu/basilisk_glue.cpp uae_cpu/memory.cpp uae_cpu/newcpu.cpp \
                 uae_cpu/readcpu.cpp uae_cpu/fpu/fpu_uae.cpp
PLAT_SRCS     := main_wii.cpp prefs_wii.cpp sys_wii.cpp timer_wii.cpp xpram_wii.cpp \
                 user_strings_wii.cpp audio_wii.cpp video_wii.cpp ui_wii.cpp plat_wiiu.cpp
CPUEMU_PARTS  := 1 2 3 4 5 6 7 8

CORE_OBJS     := $(addprefix $(BUILD)/b2/,$(CORE_SRCS:.cpp=.o))
PLAT_OBJS     := $(addprefix $(BUILD)/wiiu/,$(PLAT_SRCS:.cpp=.o))
GEN_OBJS      := $(GEN)/cpudefs.o $(GEN)/cpustbl.o
CPUEMU_OBJS   := $(foreach p,$(CPUEMU_PARTS),$(GEN)/cpuemu$(p).o)
OBJS          := $(CORE_OBJS) $(PLAT_OBJS) $(GEN_OBJS) $(CPUEMU_OBJS)

INCLUDE       := -I$(B2)/Wii -I$(GEN) -I$(B2)/include -I$(B2)/uae_cpu \
                 -I$(WIIUINPUT)/include -I$(WIIUUPDATE)/include -I$(WIIOSK)/include \
                 -I$(WUT_ROOT)/include $(foreach dir,$(PORTLIBS),-I$(dir)/include)

DEFS          := -D__WIIU__ -D__WUT__ -DFPU_UAE -DAPP_VERSION=\"$(VERSION)\" \
                 -DUPDATE_OWNER=\"$(UPDATE_OWNER)\" -DUPDATE_REPO=\"$(UPDATE_REPO)\" \
                 -DAPP_FOLDER=\"$(APP_FOLDER)\" -DAPP_TITLE="\"$(APP_TITLE)\""
CFLAGS        := -O2 -Wall -Wno-unused -Wno-sign-compare -fno-strict-aliasing \
                 -ffunction-sections $(MACHDEP) $(INCLUDE) $(DEFS) $(EXTRA_CFLAGS)
CXXFLAGS      := $(CFLAGS) -fno-exceptions -Wno-narrowing -Wno-register -std=gnu++14
LDFLAGS       := $(MACHDEP) $(RPXSPECS) -Wl,--gc-sections -Wl,-Map,$(BUILD)/$(TARGET).map
LIBS          := -L$(WIIUINPUT)/lib -L$(WIIUUPDATE)/lib -L$(WIIOSK)/lib \
                 $(foreach dir,$(PORTLIBS),-L$(dir)/lib) -L$(WUT_ROOT)/lib \
                 -lwiiuupdate -lwiiuosk -linput-wiiu -lSDL2 -lwut -lm

INPUT_LIB     := $(WIIUINPUT)/lib/libinput-wiiu.a
UPDATE_LIB    := $(WIIUUPDATE)/lib/libwiiuupdate.a
OSK_LIB       := $(WIIOSK)/lib/libwiiuosk.a

all: $(TARGET).wuhb

$(TARGET).wuhb: $(TARGET).rpx $(APP_ICON) $(APP_TV_SPLASH) $(APP_DRC_SPLASH)
	@wuhbtool $< $@ $(WUHB_OPTIONS)
	@echo built ... $@

$(TARGET).rpx: $(BUILD)/$(TARGET).elf
	@elf2rpl $< $@
	@echo built ... $@

$(BUILD)/$(TARGET).elf: $(OBJS) $(INPUT_LIB) $(UPDATE_LIB) $(OSK_LIB)
	@echo linking ... $(notdir $@)
	@$(CXX) $(OBJS) $(LDFLAGS) $(LIBS) -o $@

$(INPUT_LIB):
	@$(MAKE) --no-print-directory -C $(WIIUINPUT) $(INPUT_OPTS)

$(UPDATE_LIB):
	@$(MAKE) --no-print-directory -C $(WIIUUPDATE)

$(OSK_LIB):
	@$(MAKE) --no-print-directory -C $(WIIOSK) -f Makefile.wiiu

#---------------------------------------------------------------------------------
# the 68k core, generated on this computer
#---------------------------------------------------------------------------------
HOSTINC       := -I$(B2)/Wii -I$(GEN) -I$(B2)/include -I$(B2)/uae_cpu

$(GEN)/build68k: $(B2)/uae_cpu/build68k.c
	@mkdir -p $(GEN)
	@echo host: build68k
	@$(HOSTCC) -O1 -w $(HOSTINC) $< -o $@

$(GEN)/cpudefs.cpp: $(GEN)/build68k $(B2)/uae_cpu/table68k
	@$(GEN)/build68k < $(B2)/uae_cpu/table68k > $@

$(GEN)/gencpu: $(B2)/uae_cpu/gencpu.c $(B2)/uae_cpu/readcpu.cpp $(GEN)/cpudefs.cpp
	@echo host: gencpu
	@$(HOSTCC) -O1 -w $(HOSTINC) -c $(B2)/uae_cpu/gencpu.c -o $(GEN)/gencpu.ho
	@$(HOSTCXX) -O1 -w $(HOSTINC) -c $(B2)/uae_cpu/readcpu.cpp -o $(GEN)/readcpu.ho
	@$(HOSTCXX) -O1 -w $(HOSTINC) -c $(GEN)/cpudefs.cpp -o $(GEN)/cpudefs.ho
	@$(HOSTCXX) $(GEN)/gencpu.ho $(GEN)/readcpu.ho $(GEN)/cpudefs.ho -o $@

$(GEN)/cpuemu.cpp: $(GEN)/gencpu
	@echo host: generating the 68k emulator
	@cd $(GEN) && ./gencpu

$(GEN)/cpustbl.cpp $(GEN)/cputbl.h: $(GEN)/cpuemu.cpp

$(CPUEMU_OBJS): $(GEN)/cpuemu%.o: $(GEN)/cpuemu.cpp $(GEN)/cputbl.h
	@echo cpuemu part $*
	@$(CXX) $(CXXFLAGS) -DPART_$* -c $< -o $@

$(GEN_OBJS): $(GEN)/%.o: $(GEN)/%.cpp $(GEN)/cputbl.h
	@echo $(notdir $<)
	@$(CXX) $(CXXFLAGS) -c $< -o $@

#---------------------------------------------------------------------------------
# Basilisk II and the Wii U code
#---------------------------------------------------------------------------------
# Rebuild the Wii U code when VERSION, the update repository or EXTRA_CFLAGS change
FLAGSTAMP := $(BUILD)/flags
$(shell mkdir -p $(BUILD); echo '$(CXXFLAGS)' | cmp -s - $(FLAGSTAMP) \
	|| echo '$(CXXFLAGS)' > $(FLAGSTAMP))

$(CORE_OBJS): $(BUILD)/b2/%.o: $(B2)/%.cpp $(GEN)/cputbl.h
	@mkdir -p $(dir $@)
	@echo $(notdir $<)
	@$(CXX) $(CXXFLAGS) -MMD -MP -c $< -o $@

$(PLAT_OBJS): $(BUILD)/wiiu/%.o: $(B2)/Wii/%.cpp $(GEN)/cputbl.h Makefile $(FLAGSTAMP)
	@mkdir -p $(dir $@)
	@echo $(notdir $<)
	@$(CXX) $(CXXFLAGS) -MMD -MP -c $< -o $@

-include $(shell find $(BUILD) -name '*.d' 2>/dev/null)

#---------------------------------------------------------------------------------
DISTDIR := dist/wiiu/apps/$(APP_FOLDER)

# libwiiuupdate picks a release's zip with "wiiu" in its name, and
# libwiiupdate (the Wii build) never takes one.
dist: $(TARGET).wuhb
	@rm -rf dist/wiiu
	@mkdir -p $(DISTDIR)
	@cp $(TARGET).wuhb $(DISTDIR)/
	@cd dist && rm -f $(APP_FOLDER)-$(VERSION)-wiiu.zip \
		&& zip -qr $(APP_FOLDER)-$(VERSION)-wiiu.zip wiiu/apps/$(APP_FOLDER)
	@echo built dist/$(APP_FOLDER)-$(VERSION)-wiiu.zip

clean:
	@rm -rf build dist $(TARGET).rpx $(TARGET).wuhb
	@$(MAKE) --no-print-directory -C $(WIIUINPUT) clean
	@$(MAKE) --no-print-directory -C $(WIIUUPDATE) clean
	@$(MAKE) --no-print-directory -C $(WIIOSK) -f Makefile.wiiu clean

.PHONY: all dist clean
